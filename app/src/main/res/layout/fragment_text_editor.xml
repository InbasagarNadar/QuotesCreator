<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="#cffe"
    android:clickable="true"
    android:visibility="gone"
    tools:context=".TextEditorFragment">

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/topPanel"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#ffe"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/button_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@null"
            android:contentDescription="Cancel"
            android:src="@drawable/icon_clear_vector"
            android:textColor="@android:color/white"
            android:tint="#000"
            app:layout_columnWeight="1" />

        <ImageButton
            android:id="@+id/button_toggle_background"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@null"
            android:src="@drawable/ic_baseline_brightness_medium_24"
            app:layout_columnWeight="1" />

        <ImageButton
            android:id="@+id/button_delete_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@null"
            android:contentDescription="Delete"
            android:src="@drawable/trash_can_vector"
            android:tint="#F32013"
            app:layout_columnWeight="1" />

        <ImageButton
            android:id="@+id/button_commit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@null"
            android:contentDescription="Confirm"
            android:src="@drawable/icon_check_vector"
            android:tint="#000"
            app:layout_columnWeight="1" />
    </androidx.gridlayout.widget.GridLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="15dp"
        app:layout_constraintBottom_toTopOf="@id/_text_extra_panel"
        app:layout_constraintTop_toBottomOf="@id/topPanel">

        <ScrollView
            android:id="@+id/edit_text_scroll_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="15dp"
            android:maxHeight="100dp"
            tools:ignore="UselessParent">

            <EditText
                android:id="@+id/edit_text_input"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#00000000"
                android:gravity="center"
                android:hint="Type..."
                android:inputType="textMultiLine|textCapSentences"
                android:overScrollMode="never"
                android:textColor="#000"
                android:textColorHint="#000" />
        </ScrollView>
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/font_typeface_panel"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:background="@drawable/shape_top_rounded"
        android:backgroundTint="@color/sandal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/_font_typeface_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_top_rounded"
            android:backgroundTint="#F8E9D8"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/font_preview_text"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginEnd="80dp"
                android:fontFamily="@font/montserrat_light"
                android:padding="8dp"
                android:text="The quick brown fox jumps over the lazy dog"
                android:textColor="#000"
                android:visibility="gone"
                app:autoSizeTextType="uniform"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_language"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginEnd="80dp"
                android:padding="8dp"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/font_typeface_cancel"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:background="#0000"
                android:src="@drawable/icon_clear_vector"
                android:tint="#000"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/font_preview_text"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/font_typeface_confirm"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:background="#0000"
                android:src="@drawable/icon_check_vector"
                android:tint="#000"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/font_typeface_cancel"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/font_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/_font_typeface_title"
            tools:listitem="@layout/font_list_row" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/auto_language_parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/shape_capsule"
        android:backgroundTint="@color/sandal"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/textEditorOptions"
        app:layout_constraintLeft_toLeftOf="@id/parent"
        app:layout_constraintRight_toRightOf="@id/parent">

        <TextView
            android:id="@+id/auto_language_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingStart="10dp"
            android:text="Switch to Tamil?"
            android:textColor="#000"
            android:textSize="16dp" />

        <ImageButton
            android:id="@+id/auto_language_accept"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginStart="10dp"
            android:background="?attr/selectableItemBackground"
            android:src="@drawable/icon_check_vector"
            android:tint="#000" />

        <ImageButton
            android:id="@+id/auto_language_dismiss"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginStart="10dp"
            android:background="?attr/selectableItemBackground"
            android:paddingEnd="10dp"
            android:src="@drawable/icon_clear_vector"
            android:tint="#000" />
    </LinearLayout>

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/textEditorOptions"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_margin="5dp"
        android:background="@drawable/shape_capsule"
        android:backgroundTint="@color/sandal"
        android:elevation="10dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        app:layout_constraintBottom_toTopOf="@id/font_typeface_panel">

        <ImageButton
            android:id="@+id/button_text_toggle_font_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Font Style"

            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_font_size"
            app:layout_columnWeight="1" />

        <ImageButton
            android:id="@+id/button_text_show_typeface"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Font Style"

            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_typeface"
            app:layout_columnWeight="1" />

        <ImageButton
            android:id="@+id/button_text_bold"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Bold"

            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/bold_vector"
            app:layout_columnWeight="1" />

        <ImageButton
            android:id="@+id/button_text_italic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Italic"

            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/italic_vector"
            app:layout_columnWeight="1" />

        <ImageButton
            android:id="@+id/button_text_underline"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Underline"

            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/underline_vector"
            app:layout_columnWeight="1" />

        <ImageButton
            android:id="@+id/button_text_align"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Align"

            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/align_center"
            app:layout_columnWeight="1" />

        <ImageButton
            android:id="@+id/button_toggle_text_color_picker"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Text Color"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_baseline_format_color_text_24"
            app:layout_columnWeight="1" />

        <ImageButton
            android:id="@+id/button_toggle_text_highlight_color_picker"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Text Highlight"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_baseline_font_download_24"
            android:tint="#d00"
            app:layout_columnWeight="1" />
    </androidx.gridlayout.widget.GridLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/_text_extra_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toTopOf="@id/textEditorOptions">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintTextBackgroundPickerParent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent">

            <ToggleButton
                android:id="@+id/toggleCustomTextHighlightColor"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_margin="4dp"
                android:background="@drawable/checkbox_eyedropper_palette"
                android:checked="true"
                android:elevation="2dp"
                android:textOff=""
                android:textOn=""
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageButton
                android:id="@+id/imageButtonTextHighlightOpacity"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_margin="4dp"
                android:adjustViewBounds="true"
                android:background="@drawable/shape_rounded_corner"
                android:elevation="2dp"
                android:src="@drawable/ic_outline_font_download_24"
                android:tint="#000"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/toggleCustomTextHighlightColor" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintTextHighlightListParent"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="3dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/imageButtonTextHighlightOpacity">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerTextHighlightColor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    tools:listitem="@layout/item_color_row" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintTextHighlightCustomPickerParent"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/toggleCustomTextHighlightColor">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerRecentHighlightColors"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    app:layout_constraintEnd_toStartOf="@id/highlightPickerFrame"
                    tools:listitem="@layout/item_color_row" />

                <FrameLayout
                    android:id="@+id/highlightPickerFrame"
                    android:layout_width="200dp"
                    android:layout_height="180dp"
                    android:background="@drawable/shape_rounded_corner"
                    android:backgroundTint="#FFF5F8DE"
                    android:padding="2dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.dartt.yello.views.CustomColorPickerView
                        android:id="@+id/font_background_color_picker"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:hueSliderSpacing="5dp"
                        app:hueSliderWidth="15dp" />
                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/font_options_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:visibility="gone"
            app:columnCount="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:rowCount="2">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/shape_rounded_corner"
                android:backgroundTint="@color/sandal"
                app:layout_columnWeight="1">

                <ImageView
                    android:id="@+id/_letter_spacing_icon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_left_rounded"
                    android:backgroundTint="@color/sandalDark"
                    android:padding="8dp"
                    android:src="@drawable/letter_spacing"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="ContentDescription" />

                <SeekBar
                    android:id="@+id/seekbar_letter_spacing"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@+id/_letter_spacing_icon"
                    android:max="100"
                    app:layout_constraintLeft_toRightOf="@id/_letter_spacing_icon"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintWidth_default="spread" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/shape_rounded_corner"
                android:backgroundTint="@color/sandal"
                app:layout_columnWeight="1">

                <ImageView
                    android:id="@+id/_line_spacing_icon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_left_rounded"
                    android:backgroundTint="@color/sandalDark"
                    android:padding="8dp"
                    android:src="@drawable/line_spacing"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="ContentDescription" />

                <SeekBar
                    android:id="@+id/seekbar_line_spacing"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@+id/_line_spacing_icon"
                    android:max="50"
                    app:layout_constraintLeft_toRightOf="@id/_line_spacing_icon"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintWidth_default="spread" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/shape_rounded_corner"
                android:backgroundTint="@color/sandal"
                app:layout_columnSpan="2"
                app:layout_columnWeight="1">

                <ImageView
                    android:id="@+id/_font_size_icon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_left_rounded"
                    android:backgroundTint="@color/sandalDark"
                    android:padding="8dp"
                    android:src="@drawable/font_size_new"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="ContentDescription" />

                <SeekBar
                    android:id="@+id/seekBarFontSize"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@+id/_font_size_icon"
                    android:max="40"
                    android:progress="20"
                    app:layout_constraintLeft_toRightOf="@id/_font_size_icon"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintWidth_default="spread" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.gridlayout.widget.GridLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>