<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/create_background_fragment_height"
    android:padding="5dp"
    tools:context=".CreateBackgroundActivity">

    <HorizontalScrollView
        android:id="@+id/colorScrollView"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_margin="5dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/backgroundImageText">

        <LinearLayout
            android:id="@+id/colorButtonList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/button_pick_background_fill_color"
                android:src="@drawable/eye_dropper"
                android:scaleType="fitCenter"
                android:padding="0dp"
                android:backgroundTint="#0000"
                android:onClick="onPickBackgroundColorClick"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:fontFamily="@font/montserrat_light"
                android:textColor="#FF00"
                android:textSize="20dp" />
        </LinearLayout>

    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/gradientScrollView"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_margin="5dp"
        android:fillViewport="true"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/backgroundImageText">

        <LinearLayout
            android:id="@+id/gradientButtonList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:src="@drawable/eye_dropper"
                android:scaleType="fitCenter"
                android:padding="0dp"
                android:backgroundTint="#0000"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:fontFamily="@font/montserrat_light"
                android:textColor="#FF00"
                android:textSize="20dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/backgroundFillLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/backgroundFillText">

        <Button
            android:id="@+id/button_show_background_colors"
            android:onClick="onShowColorListClick"
            android:layout_width="40dp"
            android:layout_height="40dp" />

        <ImageButton
            android:src="@drawable/gradient"
            android:scaleType="fitCenter"
            android:padding="5dp"
            android:backgroundTint="#0000"
            android:onClick="onShowGradientListClick"
            android:layout_width="50dp"
            android:layout_height="50dp" />

        <Button
            android:layout_width="50dp"
            android:layout_height="50dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/backgroundFillText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fill Type"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/backgroundImageText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Color/ Blur Slider"
        app:layout_constraintTop_toBottomOf="@id/backgroundFillLinearLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>