<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/create_background_fragment_height"
    android:paddingLeft="5dp"
    android:paddingRight="5dp"
    tools:context=".CreateBackgroundActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginLeft="50dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <HorizontalScrollView
            android:id="@+id/colorScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/colorButtonList"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"

                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/button_pick_background_fill_color"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="2dp"
                    android:background="@drawable/shape_rounded_corner"
                    android:elevation="1dp"
                    android:onClick="onShowColorPicker"
                    android:outlineProvider="background"
                    android:padding="0dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/eye_dropper" />
            </LinearLayout>

        </HorizontalScrollView>

        <HorizontalScrollView
            android:id="@+id/gradientScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/gradientButtonList"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageButton
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginLeft="2dp"
                    android:background="@drawable/shape_rounded_corner"
                    android:elevation="1dp"
                    android:onClick="onShowGradientPicker"
                    android:outlineProvider="background"
                    android:padding="0dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/eye_dropper" />
            </LinearLayout>
        </HorizontalScrollView>

        <SeekBar
            android:id="@+id/blur_seek_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/backgroundFillLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/backgroundFillText">

        <Button
            android:id="@+id/button_show_background_colors"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:onClick="onShowColorListClick" />

        <Button
            android:layout_width="50dp"
            android:layout_height="50dp" />

        <ImageButton
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:backgroundTint="#0000"
            android:onClick="onShowGradientListClick"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/gradient" />
    </LinearLayout>

    <TextView
        android:id="@+id/backgroundFillText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fill Type"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginBottom="15dp"
        android:elevation="5dp"
        app:cardCornerRadius="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">

        <Spinner
            android:id="@+id/background_fill_spinner"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/arrow_bottom_right"
            android:popupBackground="@drawable/shape_rounded_corner"
            android:spinnerMode="dropdown" />

    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>