<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/create_background_fragment_height"

    android:paddingLeft="5dp"
    android:paddingRight="5dp"
    tools:context=".CreateBackgroundActivity">


    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="60dp"

        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/background_image_linear_layout"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:padding="5dp"
            android:clipToPadding="false"
            android:animateLayoutChanges="true"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/remove_background_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/trash_can_vector"
                android:scaleType="centerInside"
                android:padding="5dp"
                android:tint="#d00"
                android:background="@drawable/shape_rounded_corner"
                android:layout_marginEnd="5dp"
                android:elevation="4dp"
                android:onClick="onRemoveBackgroundClick"
                android:visibility="gone" />

            <ImageButton
                android:layout_width="40dp"
                android:layout_height="40dp"

                android:adjustViewBounds="true"
                android:background="@drawable/shape_rounded_corner"
                android:elevation="4dp"
                android:onClick="onSelectImageFromGalleryClick"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:tint="#000"
                android:src="@drawable/gallery_vector" />


        </LinearLayout>

    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>