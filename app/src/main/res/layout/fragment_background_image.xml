<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/create_background_fragment_height"
    android:paddingLeft="5dp"
    android:paddingRight="5dp"
    tools:context=".CreateBackgroundActivity">


    <HorizontalScrollView
        android:id="@+id/horizontal_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/background_image_linear_layout"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:animateLayoutChanges="true"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:padding="5dp">

            <ImageButton
                android:id="@+id/btn_remove_background"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/shape_rounded_corner"
                android:elevation="2dp"
                android:padding="5dp"
                android:scaleType="centerInside"
                android:src="@drawable/trash_can_vector"
                android:tint="#d00" />

            <ImageButton
                android:id="@+id/img_btn_gallery_background"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:adjustViewBounds="true"
                android:background="@drawable/shape_rounded_corner"
                android:elevation="2dp"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/gallery_vector"
                android:tint="#000" />


            <ImageButton
                android:id="@+id/button_show_internet_image_picker"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="5dp"
                android:adjustViewBounds="true"
                android:background="@drawable/shape_rounded_corner"
                android:elevation="2dp"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/more_images"
                android:tint="#000" />


        </LinearLayout>

    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>