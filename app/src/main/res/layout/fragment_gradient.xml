<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_rounded_corner"
    android:padding="5dp">


    <Button
        android:id="@+id/confirm_button"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:backgroundTint="@color/colorAccent"
        android:text="Confirm"
        android:textColor="#000"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/colors_scroll_view" />

    <Button
        android:id="@+id/cancel_button"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:background="?android:attr/selectableItemBackground"
        android:padding="5dp"

        android:text="Cancel"


        app:layout_constraintRight_toLeftOf="@id/confirm_button"
        app:layout_constraintTop_toBottomOf="@id/colors_scroll_view" />

    <Button
        android:id="@+id/hex_code_button"
        android:layout_width="90dp"
        android:layout_height="42.5dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:background="@drawable/shape_rounded_corner"
        android:elevation="0dp"
        android:text="#000000"
        app:layout_constraintLeft_toLeftOf="@id/new_gradient_image"
        app:layout_constraintTop_toBottomOf="@id/_orientation_parent" />

    <HorizontalScrollView
        android:id="@+id/colors_scroll_view"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:layout_marginLeft="5dp"

        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/color_picker">

        <LinearLayout
            android:id="@+id/color_parent"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true"
            android:orientation="horizontal">

        </LinearLayout>
    </HorizontalScrollView>

    <ImageView
        android:id="@+id/new_gradient_image"
        android:layout_width="90dp"
        android:layout_height="92.5dp"
        android:layout_marginTop="5dp"
        android:layout_marginStart="5dp"
        android:background="@drawable/shape_rounded_corner"
        android:backgroundTint="@color/colorAccent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@id/color_picker" />

    <androidx.cardview.widget.CardView
        android:id="@+id/_orientation_parent"
        android:layout_width="90dp"
        android:layout_height="42.5dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:elevation="5dp"
        app:cardCornerRadius="5dp"
        app:layout_constraintTop_toBottomOf="@id/new_gradient_image"
        app:layout_constraintLeft_toLeftOf="@id/new_gradient_image">

        <Spinner
            android:id="@+id/orientation_spinner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="@color/sandal"
            android:background="@drawable/shape_rounded_corner"
            android:popupBackground="@drawable/shape_rounded_corner"
            android:spinnerMode="dropdown" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:padding="5dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/colors_scroll_view">

        <Button
            android:id="@+id/_decrease_color_count"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/shape_rounded_corner"
            android:backgroundTint="@color/sandal"
            android:text="-" />

        <TextView
            android:id="@+id/_color_count_text_view"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="5"
            android:textColor="#333"
            android:textSize="18dp" />

        <Button
            android:id="@+id/_increase_color_count"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/shape_rounded_corner"
            android:backgroundTint="@color/sandal"
            android:text="+" />

    </LinearLayout>

    <com.dartt.yello.views.CustomColorPickerView
        android:id="@+id/color_picker"
        android:layout_width="215dp"
        android:layout_height="200dp"
        app:hueSliderSpacing="5dp"
        app:hueSliderWidth="13dp"
        app:layout_constraintLeft_toRightOf="@id/new_gradient_image"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>