<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/create_background_fragment_height"
    android:clipChildren="false"
    tools:context=".CreateBackgroundActivity">

    <HorizontalScrollView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <LinearLayout
            android:id="@+id/_ratioGrid"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false">

            <Button
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="5dp"
                android:background="@drawable/ic_ratio_1_1"
                android:backgroundTint="@color/sandal"
                android:backgroundTintMode="multiply"
                android:onClick="onRatioClick"
                android:outlineProvider="bounds"
                android:text="1:1"
                android:textColor="#0000" />

            <Button
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="5dp"
                android:background="@drawable/ic_ratio_16_9"
                android:backgroundTint="@color/sandal"
                android:backgroundTintMode="multiply"
                android:onClick="onRatioClick"
                android:outlineProvider="bounds"
                android:text="16:9"
                android:textColor="#0000" />

            <Button
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="5dp"
                android:background="@drawable/ic_ratio_4_3"
                android:backgroundTint="@color/sandal"
                android:backgroundTintMode="multiply"
                android:onClick="onRatioClick"
                android:outlineProvider="bounds"
                android:text="4:3"
                android:textColor="#0000" />

            <Button
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="5dp"
                android:background="@drawable/ic_ratio_4_5"
                android:backgroundTint="@color/sandal"
                android:backgroundTintMode="multiply"
                android:onClick="onRatioClick"
                android:outlineProvider="bounds"
                android:text="4:5"
                android:textColor="#0000" />

            <Button
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="5dp"
                android:background="@drawable/ic_ratio_3_4"
                android:backgroundTint="@color/sandal"
                android:backgroundTintMode="multiply"
                android:onClick="onRatioClick"
                android:outlineProvider="bounds"
                android:text="3:4"
                android:textColor="#0000" />

            <Button
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="5dp"
                android:background="@drawable/ic_ratio_9_16"
                android:backgroundTint="@color/sandal"
                android:backgroundTintMode="multiply"
                android:onClick="onRatioClick"
                android:outlineProvider="bounds"
                android:text="9:16"
                android:textColor="#0000" />

            <Button
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="5dp"
                android:background="@drawable/ic_ratio_1_2"
                android:backgroundTint="@color/sandal"
                android:backgroundTintMode="multiply"
                android:onClick="onRatioClick"
                android:outlineProvider="bounds"
                android:text="1:2"
                android:textColor="#0000" />

        </LinearLayout>
    </HorizontalScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>