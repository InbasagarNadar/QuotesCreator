<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_sheet_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:backgroundTint="#F5F5F5"
    android:padding="5dp">

    <Button
        android:id="@+id/new_color_image"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/shape_rounded_corner"
        android:elevation="5dp"
        android:text="#FFFFFF"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/old_color_image" />

    <ImageButton
        android:id="@+id/old_color_image"
        android:layout_width="100dp"
        android:layout_height="95dp"
        android:background="@drawable/shape_rounded_corner"
        android:elevation="5dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@id/color_picker" />


    <com.dartt.yello.views.CustomColorPickerView
        android:id="@+id/color_picker"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="10dp"
        app:hueSliderWidth="15dp"
        app:layout_constraintLeft_toRightOf="@id/old_color_image"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/confirm_button"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:backgroundTint="@color/colorAccent"
        android:text="Confirm"
        android:textColor="#000"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/color_picker" />

    <Button
        android:id="@+id/cancel_button"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:background="?android:attr/selectableItemBackground"
        android:padding="5dp"
        android:text="Cancel"
        app:layout_constraintRight_toLeftOf="@id/confirm_button"
        app:layout_constraintTop_toBottomOf="@id/color_picker" />
</androidx.constraintlayout.widget.ConstraintLayout>