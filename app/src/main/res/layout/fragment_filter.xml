<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/create_background_fragment_height"
    tools:context=".FilterFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/seekbar_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/_contrast_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:layout_width="75dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:text="Contrast"
                android:textColor="#000"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/contrast_text"
                android:layout_width="75dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:text="1.00"
                android:textColor="#000"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/contrast_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="75dp"
                android:layout_marginEnd="75dp"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/_brightness_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:layout_width="75dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:text="Brightness"
                android:textColor="#000"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/brightness_text"
                android:layout_width="75dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:text="0"
                android:textColor="#000"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/brightness_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="75dp"
                android:layout_marginEnd="75dp"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/_saturation_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:layout_width="75dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:text="Saturation"
                android:textColor="#000"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/saturation_text"
                android:layout_width="75dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:text="1.00"
                android:textColor="#000"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/saturation_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="75dp"
                android:layout_marginEnd="75dp"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.gridlayout.widget.GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="50dp"
        android:paddingEnd="50dp"
        app:columnCount="5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/seekbar_parent"
        app:orientation="horizontal">

        <ImageButton
            android:id="@+id/button_contrast"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:padding="0dp"
            android:src="@drawable/ic_contrast"
            android:tint="@color/colorAccent"
            app:layout_columnWeight="1" />

        <ImageButton
            android:id="@+id/button_brightness"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:padding="0dp"
            android:src="@drawable/ic_brightness"
            android:tint="#000"
            app:layout_columnWeight="1" />

        <ImageButton
            android:id="@+id/button_saturation"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:padding="0dp"
            android:src="@drawable/ic_saturation"
            android:tint="#000"
            app:layout_columnWeight="1" />

    </androidx.gridlayout.widget.GridLayout>
</androidx.constraintlayout.widget.ConstraintLayout>