<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CreateBackgroundActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fixedParent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/adFrame"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/sandal"
                    android:fontFamily="@font/montserrat_light"
                    android:gravity="center"
                    android:text="Dartt Developers"
                    android:textStyle="bold" />

                <com.google.android.gms.ads.AdView
                    android:id="@+id/adView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    app:adSize="BANNER"
                    app:adUnitId="@string/ad_unit_banner" />
            </FrameLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/actionBar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@color/sandal"
                app:layout_constraintTop_toTopOf="parent">

                <ImageButton
                    android:id="@+id/btn_ham"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:onClick="onHamClick"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_ham_vector"
                    app:layout_constraintStart_toStartOf="parent"

                    app:tint="@color/colorAccent" />

                <ImageButton
                    android:visibility="gone"
                    android:id="@+id/btn_save"
                    style="@style/imageButtonTint"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="right"
                    android:backgroundTint="@color/sandal"
                    android:contentDescription="Save"
                    android:onClick="onSaveClick"
                    android:scaleType="fitCenter"
                    android:src="@drawable/save_floppy"
                    app:layout_constraintEnd_toStartOf="@id/btn_save2" />

                <ImageButton

                    android:id="@+id/btn_save2"
                    style="@style/imageButtonTint"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="right"
                    android:backgroundTint="@color/sandal"
                    android:contentDescription="Save"
                    android:onClick="onExportClick"
                    android:scaleType="fitCenter"
                    android:src="@drawable/save_floppy"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ImageButton
                    android:id="@+id/btn_redo"
                    style="@style/imageButtonTint"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="right"
                    android:backgroundTint="@color/sandal"
                    android:contentDescription="Redo"
                    android:onClick="onRedoClick"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_baseline_redo_24"
                    app:layout_constraintEnd_toStartOf="@id/btn_save" />

                <ImageButton
                    android:id="@+id/btn_undo"
                    style="@style/imageButtonTint"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="right"
                    android:backgroundTint="@color/sandal"
                    android:contentDescription="Undo"
                    android:onClick="onUndoClick"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_baseline_undo_24"
                    app:layout_constraintEnd_toStartOf="@id/btn_redo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/grandhotel_regular"
                    android:gravity="center"
                    android:text="Yello"
                    android:textColor="@color/colorAccent"
                    android:textSize="35dp"
                    app:layout_constraintStart_toEndOf="@id/btn_ham" />
            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/backgroundEditorParent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="50dp"
                android:layout_marginBottom="50dp">

                <androidx.gridlayout.widget.GridLayout
                    android:id="@+id/option_menu"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_marginStart="50dp"
                    android:layout_marginEnd="50dp"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageButton
                        android:id="@+id/button_canvas_fill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="Colors"
                        android:onClick="onShowBackgroundColorFragmentClick"
                        android:src="@drawable/icon_color_palette_vector"
                        app:layout_columnWeight="1"
                        app:tint="@color/colorAccent" />

                    <ImageButton
                        android:id="@+id/button_canvas_image"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="Images"
                        android:onClick="onShowBackgroundImagesFragmentClick"
                        android:src="@drawable/gallery_vector"
                        app:layout_columnWeight="1"
                        app:tint="#000" />

                    <ImageButton
                        android:id="@+id/button_canvas_ratio"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="Aspect Ratio"
                        android:onClick="onShowRatioFragmentClick"
                        android:src="@drawable/icon_crop_vector"
                        app:layout_columnWeight="1"
                        app:tint="#000" />

                    <ImageButton
                        android:id="@+id/button_filter"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="Filter"
                        android:onClick="onShowFilterFragmentClick"
                        android:src="@drawable/ic_photo_filter"
                        android:visibility="gone"
                        app:layout_columnWeight="1"
                        app:tint="#000" />

                    <ImageButton
                        android:id="@+id/button_add_text"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="Text"
                        android:onClick="onAddTextClick"
                        android:src="@drawable/icon_text_vector"
                        app:layout_columnWeight="1" />

                    <ImageButton
                        android:id="@+id/button_add_sticker"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="Stickers"
                        android:onClick="onShowStickerSheetClick"
                        android:src="@drawable/icon_sticker_vector"
                        app:layout_columnWeight="1" />

                </androidx.gridlayout.widget.GridLayout>


                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/frame_editor_fragment"
                    android:name="com.dartt.yello.EditorFragment"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginBottom="5dp"


                    app:layout_constraintBottom_toTopOf="@id/viewPager"

                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0"
                    app:layout_constraintVertical_weight="1" />

                <FrameLayout
                    android:id="@+id/canvas"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginBottom="5dp"
                    android:background="#fff"
                    android:visibility="gone"

                    app:layout_constraintBottom_toTopOf="@id/viewPager"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0"
                    app:layout_constraintVertical_weight="1">

                    <ImageView
                        android:id="@+id/bg_backgroundImageView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />

                    <View
                        android:id="@+id/alignment_guide_x"
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="-100dp"
                        android:background="#00BCD4"
                        android:clickable="false"
                        android:focusable="false"
                        android:foregroundGravity="center" />

                    <View
                        android:id="@+id/alignment_guide_y"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="-100dp"
                        android:background="#00BCD4"
                        android:clickable="false"
                        android:focusable="false"
                        android:foregroundGravity="center" />
                </FrameLayout>


                <com.dartt.yello.views.NonSwipeableViewPager
                    android:id="@+id/viewPager"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/create_background_fragment_height"
                    app:layout_constraintBottom_toTopOf="@id/option_menu" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/sticker_editor_fragment"
                android:name="com.dartt.yello.StickerEditorFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/sticker_editor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="50dp"
                android:animateLayoutChanges="true"
                android:background="#7000"
                android:clickable="true"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/button_sticker_commit"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_margin="10dp"
                    android:background="@null"
                    android:src="@drawable/icon_check_vector"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#fff" />

                <ImageButton
                    android:id="@+id/button_sticker_cancel"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_margin="10dp"
                    android:background="@null"
                    android:src="@drawable/icon_clear_vector"
                    android:textColor="@android:color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#fff" />

                <ImageButton
                    android:id="@+id/button_sticker_delete"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_margin="10dp"
                    android:background="@null"
                    android:src="@drawable/trash_can_vector"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#F32013" />

                <ImageView
                    android:id="@+id/sticker_image_view"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_margin="15dp"
                    android:padding="50dp"
                    android:src="@drawable/sticker_29_cat"
                    app:layout_constraintBottom_toTopOf="@id/sticker_options_panel"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/button_sticker_commit" />


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/sticker_options_panel"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/shape_rounded_corner"
                    android:backgroundTint="@color/sandal"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageView
                        android:id="@+id/_sticker_opacity_icon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/shape_left_rounded"
                        android:backgroundTint="#F5F8DE"
                        android:padding="8dp"
                        android:src="@drawable/ic_opacity"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="ContentDescription" />

                    <SeekBar
                        android:id="@+id/seekBar_sticker_opacity"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_toEndOf="@+id/_sticker_opacity_icon"
                        android:max="100"
                        app:layout_constraintLeft_toRightOf="@id/_sticker_opacity_icon"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintWidth_default="spread" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/text_editor_fragment"
            android:name="com.dartt.yello.TextEditorFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/drawer"
        android:layout_width="275dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/layout_navigation_header">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="200dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="100dp"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/button_navigation_settings"
                        style="@style/NavigationBarButtonStyle"
                        android:drawableStart="@drawable/ic_settings_vector"
                        android:onClick="OnNavigationItemClick"
                        android:text="Settings" />

                    <Button
                        android:id="@+id/button_navigation_fonts"
                        style="@style/NavigationBarButtonStyle"
                        android:drawableStart="@drawable/ic_baseline_font_download_24"
                        android:onClick="OnNavigationItemClick"
                        android:text="Fonts/ Languages" />

                    <Button
                        android:id="@+id/button_navigation_rate_app"
                        style="@style/NavigationBarButtonStyle"
                        android:drawableStart="@drawable/ic_star"
                        android:onClick="OnNavigationItemClick"
                        android:text="Rate App" />

                    <Button
                        android:id="@+id/button_navigation_contact_us"
                        style="@style/NavigationBarButtonStyle"
                        android:drawableStart="@drawable/ic_contact_mail"
                        android:onClick="OnNavigationItemClick"
                        android:text="Contact Us" />

                    <Button
                        android:id="@+id/button_navigation_support_us"
                        style="@style/NavigationBarButtonStyle"
                        android:drawableStart="@drawable/ic_support_us"
                        android:onClick="OnNavigationItemClick"
                        android:text="Support Us" />

                    <Button
                        android:id="@+id/button_faq"
                        style="@style/NavigationBarButtonStyle"
                        android:drawableStart="@drawable/ic_faq"
                        android:onClick="OnNavigationItemClick"
                        android:text="FAQ" />
                </LinearLayout>
            </ScrollView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent">

                <Button
                    android:id="@+id/button_navigation_get_featured"
                    style="@style/NavigationBarButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_quote"
                    android:onClick="OnNavigationItemClick"
                    android:text="Get Featured"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.gridlayout.widget.GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:paddingStart="75dp"
                    android:paddingEnd="75dp"
                    app:layout_constraintTop_toBottomOf="@id/button_navigation_get_featured">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/button_navigation_instagram"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:onClick="OnNavigationItemClick"
                        android:src="@drawable/ic_instagram"
                        app:layout_columnWeight="1" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/button_navigation_facebook"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:onClick="OnNavigationItemClick"
                        android:src="@drawable/ic_facebook"
                        app:layout_columnWeight="1" />
                </androidx.gridlayout.widget.GridLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>